{
  "name": "toplarss",
  "image": "mcr.microsoft.com/playwright:v1.58.2-jammy",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "toplarss Web Arayüzü",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "npm ci && npm run setup && npm run build",
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
