{
  "name": "fetchrss-clone",
  "version": "1.0.0",
  "description": "Web to RSS 2.0 Feed Generator with visual CSS picker (FetchRSS Clone)",
  "main": "dist/server.js",
  "scripts": {
    "setup": "npx playwright install chromium --with-deps",
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "update:sygm": "node scripts/update-sygm.js",
    "test": "vitest run",
    "scrape": "tsx src/cli_scrape.ts"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "express": "^4.22.1",
    "express-rate-limit": "^7.5.1",
    "feed": "^5.0.3",
    "node-cron": "^4.2.1",
    "playwright": "^1.58.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^25.5.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
